<?xml version='1.0' encoding='windows-1252'?>
<!-- Leaf Text installs per-user, by default into %LOCALAPPDATA%\Programs\leaftext.

     This is what makes updates silent. Windows will not let an unelevated
     process write to Program Files, so a per-machine install cannot be replaced
     without a UAC prompt every single time; a per-user one can be replaced by
     the app itself with no prompt at all. That is the whole reason for the
     scope, and it is not negotiable against the install location.

     Consequences, all handled below:
       - Components landing in the user profile take an HKCU registry keypath
         rather than a file keypath (ICE38), and every folder they create is
         named in RemoveFolder so uninstall leaves nothing behind (ICE64).
       - candle will not generate a GUID for a component holding both a file and
         a registry keypath (CNDL0230), so MainExecutable's GUID is fixed.
       - The Install button carries no elevation shield: nothing is elevated.
       - A per-user package cannot remove a copy installed per-machine by
         v0.1.364 or earlier. That is a deliberate clean break — the release
         notes tell people to uninstall the old version first. Nothing in the
         app tries to do it for them; the two attempts at an automatic migration
         are what broke v0.1.363 and v0.1.364.

     There is deliberately no Start Menu shortcut and no desktop shortcut.

     `.github/workflows/validate-installer.yml` compiles this file and asserts
     the scope and the absence of shortcuts. Run it on a branch before tagging;
     the WiX toolset cannot be run on a dev machine, and shipping this file
     unproven has already cost two version numbers. -->
<Wix xmlns='http://schemas.microsoft.com/wix/2006/wi'>
    <Product
        Id='*'
        Name='Leaf Text'
        UpgradeCode='1A3F5501-5C62-44AC-AC64-CBC56702E3FD'
        Manufacturer='ryanallen'
        Language='1033'
        Codepage='1252'
        Version='$(var.Version)'>

        <Package
            Id='*'
            Keywords='Installer'
            Description='An app for reading and editing markdown and HTML beautifully -- no code, just the content.'
            Manufacturer='ryanallen'
            InstallerVersion='450'
            Languages='1033'
            Compressed='yes'
            InstallScope='perUser'
            SummaryCodepage='1252'/>

        <MajorUpgrade
            Schedule='afterInstallInitialize'
            DowngradeErrorMessage='A newer version of [ProductName] is already installed. Setup will now exit.'/>

        <Media Id='1' Cabinet='media1.cab' EmbedCab='yes'/>

        <!-- Reinstate the folder the user picked last time.
             APPLICATIONFOLDER defaults to the Directory tree below, but AppSearch
             overwrites it from the registry when a previous install recorded one,
             so Change... is honored on every later upgrade instead of silently
             relocating the app back to the default. This also runs for the
             updater's silent `msiexec /qn`, which is where it matters most. -->
        <Property Id='APPLICATIONFOLDER' Secure='yes'>
            <RegistrySearch
                Id='PreviousInstallFolder'
                Root='HKCU'
                Key='Software\ryanallen\leaftext'
                Name='InstallFolder'
                Type='raw'/>
        </Property>

        <Directory Id='TARGETDIR' Name='SourceDir'>
            <Directory Id='LocalAppDataFolder'>
                <!-- Where per-user installers conventionally land, so leaftext
                     sits beside the other apps installed this way. -->
                <Directory Id='LocalProgramsFolder' Name='Programs'>
                    <Directory Id='APPLICATIONFOLDER' Name='leaftext'>
                        <Directory Id='Bin' Name='bin'>
                            <!-- Fixed GUID; see the CNDL0230 note at the top.
                                 Never change it: MSI identifies the installed
                                 component by this value across upgrades. -->
                            <Component Id='MainExecutable' Guid='CBEF1B10-A237-4CBE-8204-58C026FB238F'>
                                <File
                                    Id='MainExecutableFile'
                                    Name='leaftext.exe'
                                    DiskId='1'
                                    Source='$(var.CargoTargetBinDir)\leaftext.exe'
                                    KeyPath='no'/>
                                <!-- Doubles as the component's HKCU keypath and
                                     as the folder the search above reads back. -->
                                <RegistryValue
                                    Root='HKCU'
                                    Key='Software\ryanallen\leaftext'
                                    Name='InstallFolder'
                                    Type='string'
                                    Value='[APPLICATIONFOLDER]'
                                    KeyPath='yes'/>
                                <RemoveFolder Id='RemoveBinFolder' Directory='Bin' On='uninstall'/>
                                <RemoveFolder Id='RemoveApplicationFolder' Directory='APPLICATIONFOLDER' On='uninstall'/>
                                <!-- RemoveFolder only deletes empty folders, so
                                     naming the shared Programs folder cannot
                                     disturb anything else installed there. -->
                                <RemoveFolder Id='RemoveLocalProgramsFolder' Directory='LocalProgramsFolder' On='uninstall'/>
                            </Component>
                        </Directory>
                    </Directory>
                </Directory>
            </Directory>
        </Directory>

        <!-- One feature, one file, nothing optional: no customize screen, and
             no Start Menu shortcut. -->
        <Feature
            Id='MainFeature'
            Title='Application'
            Description='Installs [ProductName].'
            Level='1'
            AllowAdvertise='no'
            Absent='disallow'>
            <ComponentRef Id='MainExecutable'/>
        </Feature>

        <SetProperty Id='ARPINSTALLLOCATION' Value='[APPLICATIONFOLDER]' After='CostFinalize'/>
        <Property Id='ARPHELPLINK' Value='https://github.com/ryanallen/leaftext'/>

        <!-- The leaf icon for Installed Apps / Add-Remove Programs. -->
        <Icon Id='leaftext.ico' SourceFile='src\assets\leaf.ico'/>
        <Property Id='ARPPRODUCTICON' Value='leaftext.ico'/>

        <!-- Exactly one screen: pick the folder, then install. No stock WixUI
             set is used because each one hardcodes a wizard around its dialogs
             (WixUI_InstallDir wraps the folder picker in welcome, license, and
             confirm screens; the license screen is where the placeholder lorem
             ipsum RTF came from). Stock dialogs self-sequence, so referencing
             only the folder dialog plus support dialogs leaves the rest out of
             the MSI entirely.

             The dialog is WiX's InstallDirDlg minus the Back button (nothing
             precedes it) and the banner bitmap, with Install in place of Next.

             No ExitDialog either, so the window closes when the install ends.
             ICE20 rejects that, which is why build-windows-release.ps1 passes
             -sice:ICE20 to light. -->
        <UI>
            <UIRef Id='WixUI_Common'/>

            <TextStyle Id='WixUI_Font_Normal' FaceName='Tahoma' Size='8'/>
            <TextStyle Id='WixUI_Font_Bigger' FaceName='Tahoma' Size='12'/>
            <TextStyle Id='WixUI_Font_Title' FaceName='Tahoma' Size='9' Bold='yes'/>
            <Property Id='DefaultUIFont' Value='WixUI_Font_Normal'/>

            <!-- Names the directory the path editor edits, indirectly. -->
            <Property Id='WIXUI_INSTALLDIR' Value='APPLICATIONFOLDER'/>

            <!-- Support dialogs: progress, plus browse, failure, cancel,
                 resume, and locked-file prompts. -->
            <DialogRef Id='PrepareDlg'/>
            <DialogRef Id='ProgressDlg'/>
            <DialogRef Id='BrowseDlg'/>
            <DialogRef Id='InvalidDirDlg'/>
            <DialogRef Id='CancelDlg'/>
            <DialogRef Id='DiskCostDlg'/>
            <DialogRef Id='ErrorDlg'/>
            <DialogRef Id='FatalError'/>
            <DialogRef Id='UserExit'/>
            <DialogRef Id='ResumeDlg'/>
            <DialogRef Id='FilesInUse'/>
            <DialogRef Id='MsiRMFilesInUse'/>

            <Dialog Id='LeafInstallDirDlg' Width='370' Height='270' Title='!(loc.InstallDirDlg_Title)'>
                <Control Id='Title' Type='Text' X='15' Y='6' Width='200' Height='15'
                         NoPrefix='yes' Text='!(loc.InstallDirDlgTitle)'/>
                <Control Id='Description' Type='Text' X='25' Y='23' Width='280' Height='15'
                         NoPrefix='yes' Text='Choose where to install [ProductName].'/>
                <Control Id='BannerLine' Type='Line' X='0' Y='44' Width='370' Height='0'/>

                <Control Id='FolderLabel' Type='Text' X='20' Y='60' Width='290' Height='30'
                         NoPrefix='yes' Text='!(loc.InstallDirDlgFolderLabel)'/>
                <Control Id='Folder' Type='PathEdit' X='20' Y='100' Width='320' Height='18'
                         Property='WIXUI_INSTALLDIR' Indirect='yes'/>
                <Control Id='ChangeFolder' Type='PushButton' X='20' Y='120' Width='56' Height='17'
                         Text='!(loc.InstallDirDlgChange)'/>

                <Control Id='BottomLine' Type='Line' X='0' Y='234' Width='370' Height='0'/>
                <!-- No elevation shield: a per-user install raises no UAC prompt. -->
                <Control Id='Install' Type='PushButton'
                         X='212' Y='243' Width='80' Height='17' Default='yes'
                         Text='!(loc.VerifyReadyDlgInstall)'/>
                <Control Id='Cancel' Type='PushButton' X='304' Y='243' Width='56' Height='17'
                         Cancel='yes' Text='!(loc.WixUICancel)'>
                    <Publish Event='SpawnDialog' Value='CancelDlg'>1</Publish>
                </Control>
            </Dialog>

            <!-- Change... opens the browse dialog on the current path. -->
            <Publish Dialog='LeafInstallDirDlg' Control='ChangeFolder'
                     Property='_BrowseProperty' Value='[WIXUI_INSTALLDIR]' Order='1'>1</Publish>
            <Publish Dialog='LeafInstallDirDlg' Control='ChangeFolder'
                     Event='SpawnDialog' Value='BrowseDlg' Order='2'>1</Publish>

            <!-- Install: set the path, validate, then run unless it is bad. -->
            <Publish Dialog='LeafInstallDirDlg' Control='Install'
                     Event='SetTargetPath' Value='[WIXUI_INSTALLDIR]' Order='1'>1</Publish>
            <Publish Dialog='LeafInstallDirDlg' Control='Install'
                     Event='DoAction' Value='WixUIValidatePath' Order='2'>NOT WIXUI_DONTVALIDATEPATH</Publish>
            <Publish Dialog='LeafInstallDirDlg' Control='Install'
                     Event='SpawnDialog' Value='InvalidDirDlg' Order='3'><![CDATA[NOT WIXUI_DONTVALIDATEPATH AND WIXUI_INSTALLDIR_VALID<>"1"]]></Publish>
            <Publish Dialog='LeafInstallDirDlg' Control='Install'
                     Event='EndDialog' Value='Return' Order='4'>WIXUI_DONTVALIDATEPATH OR WIXUI_INSTALLDIR_VALID="1"</Publish>

            <!-- Stock browse-dialog path validation. -->
            <Publish Dialog='BrowseDlg' Control='OK'
                     Event='DoAction' Value='WixUIValidatePath' Order='3'>1</Publish>
            <Publish Dialog='BrowseDlg' Control='OK'
                     Event='SpawnDialog' Value='InvalidDirDlg' Order='4'><![CDATA[NOT WIXUI_DONTVALIDATEPATH AND WIXUI_INSTALLDIR_VALID<>"1"]]></Publish>

            <!-- Only fresh installs get a screen; uninstall and repair are silent. -->
            <InstallUISequence>
                <Show Dialog='LeafInstallDirDlg' Before='ProgressDlg'>NOT Installed</Show>
            </InstallUISequence>
        </UI>

        <!-- No maintenance UI, so hide the Modify button in Installed Apps. -->
        <Property Id='ARPNOMODIFY' Value='1'/>
    </Product>
</Wix>
