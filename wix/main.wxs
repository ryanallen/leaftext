<?xml version='1.0' encoding='windows-1252'?>
<!-- Leaf Text installs per-user, by default into %LOCALAPPDATA%\Programs\leaftext.

     This is what makes updates silent. Windows will not let an unelevated
     process write to Program Files, so a per-machine install cannot be replaced
     without a UAC prompt every single time; a per-user one can be replaced by
     the app itself with no prompt at all. That is the whole reason for the
     scope, and it is not negotiable against the install location.

     Consequences, all handled below:
       - Components landing in the user profile take an HKCU registry keypath
         rather than a file keypath (ICE38), and every folder they create is
         named in RemoveFolder so uninstall leaves nothing behind (ICE64).
       - candle will not generate a GUID for a component holding both a file and
         a registry keypath (CNDL0230), so MainExecutable's GUID is fixed.
       - The Install button carries no elevation shield: nothing is elevated.
       - A per-user package cannot remove a copy installed per-machine by
         v0.1.364 or earlier. That is a deliberate clean break — the release
         notes tell people to uninstall the old version first. Nothing in the
         app tries to do it for them; the two attempts at an automatic migration
         are what broke v0.1.363 and v0.1.364.

     There is one Start Menu entry and no desktop shortcut. The Start Menu
     entry is not optional: it is the only way to launch or find the app.

     `.github/workflows/validate-installer.yml` compiles this file and asserts
     the install scope, the remembered folder, and exactly one shortcut. Run it on a branch before tagging;
     the WiX toolset cannot be run on a dev machine, and shipping this file
     unproven has already cost two version numbers. -->
<Wix xmlns='http://schemas.microsoft.com/wix/2006/wi'>
    <Product
        Id='*'
        Name='Leaf Text'
        UpgradeCode='1A3F5501-5C62-44AC-AC64-CBC56702E3FD'
        Manufacturer='ryanallen'
        Language='1033'
        Codepage='1252'
        Version='$(var.Version)'>

        <Package
            Id='*'
            Keywords='Installer'
            Description='An app for reading and editing markdown and HTML beautifully -- no code, just the content.'
            Manufacturer='ryanallen'
            InstallerVersion='450'
            Languages='1033'
            Compressed='yes'
            InstallScope='perUser'
            SummaryCodepage='1252'/>

        <MajorUpgrade
            Schedule='afterInstallInitialize'
            DowngradeErrorMessage='A newer version of [ProductName] is already installed. Setup will now exit.'/>

        <Media Id='1' Cabinet='media1.cab' EmbedCab='yes'/>

        <!-- Reinstate the folder the user picked last time.
             APPLICATIONFOLDER defaults to the Directory tree below, but AppSearch
             overwrites it from the registry when a previous install recorded one,
             so Change... is honored on every later upgrade instead of silently
             relocating the app back to the default. This also runs for the
             updater's silent `msiexec /qn`, which is where it matters most. -->
        <Property Id='APPLICATIONFOLDER' Secure='yes'>
            <RegistrySearch
                Id='PreviousInstallFolder'
                Root='HKCU'
                Key='Software\ryanallen\leaftext'
                Name='InstallFolder'
                Type='raw'/>
        </Property>

        <Directory Id='TARGETDIR' Name='SourceDir'>
            <Directory Id='LocalAppDataFolder'>
                <!-- Where per-user installers conventionally land, so leaftext
                     sits beside the other apps installed this way. -->
                <Directory Id='LocalProgramsFolder' Name='Programs'>
                    <Directory Id='APPLICATIONFOLDER' Name='leaftext'>
                        <Directory Id='Bin' Name='bin'>
                            <!-- Fixed GUID; see the CNDL0230 note at the top.
                                 Never change it: MSI identifies the installed
                                 component by this value across upgrades. -->
                            <Component Id='MainExecutable' Guid='CBEF1B10-A237-4CBE-8204-58C026FB238F'>
                                <File
                                    Id='MainExecutableFile'
                                    Name='leaftext.exe'
                                    DiskId='1'
                                    Source='$(var.CargoTargetBinDir)\leaftext.exe'
                                    KeyPath='no'/>
                                <!-- Doubles as the component's HKCU keypath and
                                     as the folder the search above reads back. -->
                                <RegistryValue
                                    Root='HKCU'
                                    Key='Software\ryanallen\leaftext'
                                    Name='InstallFolder'
                                    Type='string'
                                    Value='[APPLICATIONFOLDER]'
                                    KeyPath='yes'/>
                                <RemoveFolder Id='RemoveBinFolder' Directory='Bin' On='uninstall'/>
                                <RemoveFolder Id='RemoveApplicationFolder' Directory='APPLICATIONFOLDER' On='uninstall'/>
                                <!-- RemoveFolder only deletes empty folders, so
                                     naming the shared Programs folder cannot
                                     disturb anything else installed there. -->
                                <RemoveFolder Id='RemoveLocalProgramsFolder' Directory='LocalProgramsFolder' On='uninstall'/>
                            </Component>
                        </Directory>
                    </Directory>
                </Directory>
            </Directory>
            <Directory Id='ProgramMenuFolder'/>
        </Directory>

        <!-- The Start Menu entry is how the app is launched and how it is found
             by typing its name. Without it the install is unreachable: the exe
             sits in a folder nobody browses to, with nothing to click and
             nothing for Windows search to match. It goes straight into
             ProgramMenuFolder rather than a subfolder, so there is one entry and
             no leftover folder to clean up. A per-user install resolves
             ProgramMenuFolder to this user's Start Menu, so there is exactly one
             of them. -->
        <DirectoryRef Id='ProgramMenuFolder'>
            <Component Id='ApplicationStartMenuShortcut' Guid='*'>
                <Shortcut
                    Id='ApplicationStartMenuShortcut'
                    Name='Leaf Text'
                    Description='Launch Leaf Text'
                    Target='[Bin]leaftext.exe'
                    WorkingDirectory='Bin'/>
                <!-- A non-advertised shortcut in the user profile needs an HKCU
                     keypath (ICE38/ICE43). -->
                <RegistryValue
                    Root='HKCU'
                    Key='Software\ryanallen\leaftext'
                    Name='shortcut'
                    Type='integer'
                    Value='1'
                    KeyPath='yes'/>
            </Component>
        </DirectoryRef>

        <!-- File associations. A document class nobody claims gets Explorer's
             generic page icon and cannot be opened by double-click, so a reader
             that is not registered for .md is one nobody opens files with.
             Everything is under HKCU: a per-user install cannot write HKLM and
             does not need to.

             Windows 8+ honors its own UserChoice above these keys, so claiming an
             extension takes effect where nothing else has claimed it and is
             ignored where the user already chose — which is the correct behavior
             in both cases. The Capabilities keys put the app in Settings > Default
             apps so the choice can be made there in one click. -->
        <DirectoryRef Id='Bin'>
            <Component Id='FileAssociations' Guid='*'>
                <RegistryValue
                    Root='HKCU'
                    Key='Software\ryanallen\leaftext'
                    Name='associations'
                    Type='integer'
                    Value='1'
                    KeyPath='yes'/>

                <!-- The document class: name, icon, and how to open it. Index 0 is
                     the exe's own leaf icon, so documents show it too. -->
                <RegistryValue Root='HKCU' Key='Software\Classes\LeafText.Document' Type='string' Value='Leaf Text Document'/>
                <RegistryValue Root='HKCU' Key='Software\Classes\LeafText.Document' Name='FriendlyTypeName' Type='string' Value='Leaf Text Document'/>
                <RegistryValue Root='HKCU' Key='Software\Classes\LeafText.Document\DefaultIcon' Type='string' Value='&quot;[#MainExecutableFile]&quot;,0'/>
                <RegistryValue Root='HKCU' Key='Software\Classes\LeafText.Document\shell\open\command' Type='string' Value='&quot;[#MainExecutableFile]&quot; &quot;%1&quot;'/>
                <RemoveRegistryKey Root='HKCU' Key='Software\Classes\LeafText.Document' Action='removeOnUninstall'/>

                <!-- Every extension src/format.rs reads;
                     `installer_claims_every_readable_extension` pins the two lists. -->
                <RegistryValue Root='HKCU' Key='Software\Classes\.md' Type='string' Value='LeafText.Document'/>
                <RegistryValue Root='HKCU' Key='Software\Classes\.md\OpenWithProgids' Name='LeafText.Document' Type='string' Value=''/>
                <RegistryValue Root='HKCU' Key='Software\Classes\.markdown' Type='string' Value='LeafText.Document'/>
                <RegistryValue Root='HKCU' Key='Software\Classes\.markdown\OpenWithProgids' Name='LeafText.Document' Type='string' Value=''/>
                <RegistryValue Root='HKCU' Key='Software\Classes\.mdown' Type='string' Value='LeafText.Document'/>
                <RegistryValue Root='HKCU' Key='Software\Classes\.mdown\OpenWithProgids' Name='LeafText.Document' Type='string' Value=''/>
                <RegistryValue Root='HKCU' Key='Software\Classes\.xml' Type='string' Value='LeafText.Document'/>
                <RegistryValue Root='HKCU' Key='Software\Classes\.xml\OpenWithProgids' Name='LeafText.Document' Type='string' Value=''/>
                <RegistryValue Root='HKCU' Key='Software\Classes\.json' Type='string' Value='LeafText.Document'/>
                <RegistryValue Root='HKCU' Key='Software\Classes\.json\OpenWithProgids' Name='LeafText.Document' Type='string' Value=''/>
                <RegistryValue Root='HKCU' Key='Software\Classes\.yaml' Type='string' Value='LeafText.Document'/>
                <RegistryValue Root='HKCU' Key='Software\Classes\.yaml\OpenWithProgids' Name='LeafText.Document' Type='string' Value=''/>
                <RegistryValue Root='HKCU' Key='Software\Classes\.yml' Type='string' Value='LeafText.Document'/>
                <RegistryValue Root='HKCU' Key='Software\Classes\.yml\OpenWithProgids' Name='LeafText.Document' Type='string' Value=''/>
                <RegistryValue Root='HKCU' Key='Software\Classes\.eml' Type='string' Value='LeafText.Document'/>
                <RegistryValue Root='HKCU' Key='Software\Classes\.eml\OpenWithProgids' Name='LeafText.Document' Type='string' Value=''/>
                <RegistryValue Root='HKCU' Key='Software\Classes\.mht' Type='string' Value='LeafText.Document'/>
                <RegistryValue Root='HKCU' Key='Software\Classes\.mht\OpenWithProgids' Name='LeafText.Document' Type='string' Value=''/>
                <RegistryValue Root='HKCU' Key='Software\Classes\.mhtml' Type='string' Value='LeafText.Document'/>
                <RegistryValue Root='HKCU' Key='Software\Classes\.mhtml\OpenWithProgids' Name='LeafText.Document' Type='string' Value=''/>

                <!-- Puts leaftext in the "Open with" list even for extensions it
                     does not own. -->
                <RegistryValue Root='HKCU' Key='Software\Classes\Applications\leaftext.exe' Name='FriendlyAppName' Type='string' Value='Leaf Text'/>
                <RegistryValue Root='HKCU' Key='Software\Classes\Applications\leaftext.exe\shell\open\command' Type='string' Value='&quot;[#MainExecutableFile]&quot; &quot;%1&quot;'/>
                <RegistryValue Root='HKCU' Key='Software\Classes\Applications\leaftext.exe\SupportedTypes' Name='.md' Type='string' Value=''/>
                <RegistryValue Root='HKCU' Key='Software\Classes\Applications\leaftext.exe\SupportedTypes' Name='.markdown' Type='string' Value=''/>
                <RegistryValue Root='HKCU' Key='Software\Classes\Applications\leaftext.exe\SupportedTypes' Name='.mdown' Type='string' Value=''/>
                <RegistryValue Root='HKCU' Key='Software\Classes\Applications\leaftext.exe\SupportedTypes' Name='.xml' Type='string' Value=''/>
                <RegistryValue Root='HKCU' Key='Software\Classes\Applications\leaftext.exe\SupportedTypes' Name='.json' Type='string' Value=''/>
                <RegistryValue Root='HKCU' Key='Software\Classes\Applications\leaftext.exe\SupportedTypes' Name='.yaml' Type='string' Value=''/>
                <RegistryValue Root='HKCU' Key='Software\Classes\Applications\leaftext.exe\SupportedTypes' Name='.yml' Type='string' Value=''/>
                <RegistryValue Root='HKCU' Key='Software\Classes\Applications\leaftext.exe\SupportedTypes' Name='.eml' Type='string' Value=''/>
                <RegistryValue Root='HKCU' Key='Software\Classes\Applications\leaftext.exe\SupportedTypes' Name='.mht' Type='string' Value=''/>
                <RegistryValue Root='HKCU' Key='Software\Classes\Applications\leaftext.exe\SupportedTypes' Name='.mhtml' Type='string' Value=''/>
                <RemoveRegistryKey Root='HKCU' Key='Software\Classes\Applications\leaftext.exe' Action='removeOnUninstall'/>

                <!-- Default Programs registration, so the app is listed in
                     Settings > Default apps rather than only reachable per-file. -->
                <RegistryValue Root='HKCU' Key='Software\ryanallen\leaftext\Capabilities' Name='ApplicationName' Type='string' Value='Leaf Text'/>
                <RegistryValue Root='HKCU' Key='Software\ryanallen\leaftext\Capabilities' Name='ApplicationDescription' Type='string' Value='Read Markdown, XML, JSON, YAML and email documents.'/>
                <RegistryValue Root='HKCU' Key='Software\ryanallen\leaftext\Capabilities\FileAssociations' Name='.md' Type='string' Value='LeafText.Document'/>
                <RegistryValue Root='HKCU' Key='Software\ryanallen\leaftext\Capabilities\FileAssociations' Name='.markdown' Type='string' Value='LeafText.Document'/>
                <RegistryValue Root='HKCU' Key='Software\ryanallen\leaftext\Capabilities\FileAssociations' Name='.mdown' Type='string' Value='LeafText.Document'/>
                <RegistryValue Root='HKCU' Key='Software\ryanallen\leaftext\Capabilities\FileAssociations' Name='.xml' Type='string' Value='LeafText.Document'/>
                <RegistryValue Root='HKCU' Key='Software\ryanallen\leaftext\Capabilities\FileAssociations' Name='.json' Type='string' Value='LeafText.Document'/>
                <RegistryValue Root='HKCU' Key='Software\ryanallen\leaftext\Capabilities\FileAssociations' Name='.yaml' Type='string' Value='LeafText.Document'/>
                <RegistryValue Root='HKCU' Key='Software\ryanallen\leaftext\Capabilities\FileAssociations' Name='.yml' Type='string' Value='LeafText.Document'/>
                <RegistryValue Root='HKCU' Key='Software\ryanallen\leaftext\Capabilities\FileAssociations' Name='.eml' Type='string' Value='LeafText.Document'/>
                <RegistryValue Root='HKCU' Key='Software\ryanallen\leaftext\Capabilities\FileAssociations' Name='.mht' Type='string' Value='LeafText.Document'/>
                <RegistryValue Root='HKCU' Key='Software\ryanallen\leaftext\Capabilities\FileAssociations' Name='.mhtml' Type='string' Value='LeafText.Document'/>
                <RegistryValue Root='HKCU' Key='Software\RegisteredApplications' Name='Leaf Text' Type='string' Value='Software\ryanallen\leaftext\Capabilities'/>
            </Component>
        </DirectoryRef>

        <!-- One feature, nothing optional, so there is no customize screen. -->
        <Feature
            Id='MainFeature'
            Title='Application'
            Description='Installs [ProductName].'
            Level='1'
            AllowAdvertise='no'
            Absent='disallow'>
            <ComponentRef Id='MainExecutable'/>
            <ComponentRef Id='ApplicationStartMenuShortcut'/>
            <ComponentRef Id='FileAssociations'/>
        </Feature>

        <SetProperty Id='ARPINSTALLLOCATION' Value='[APPLICATIONFOLDER]' After='CostFinalize'/>
        <Property Id='ARPHELPLINK' Value='https://github.com/ryanallen/leaftext'/>

        <!-- The leaf icon for Installed Apps / Add-Remove Programs. -->
        <Icon Id='leaftext.ico' SourceFile='src\assets\leaf.ico'/>
        <Property Id='ARPPRODUCTICON' Value='leaftext.ico'/>

        <!-- Exactly one screen: pick the folder, then install. No stock WixUI
             set is used because each one hardcodes a wizard around its dialogs
             (WixUI_InstallDir wraps the folder picker in welcome, license, and
             confirm screens; the license screen is where the placeholder lorem
             ipsum RTF came from). Stock dialogs self-sequence, so referencing
             only the folder dialog plus support dialogs leaves the rest out of
             the MSI entirely.

             The dialog is WiX's InstallDirDlg minus the Back button (nothing
             precedes it) and the banner bitmap, with Install in place of Next.

             No ExitDialog either, so the window closes when the install ends.
             ICE20 rejects that, which is why build-windows-release.ps1 passes
             -sice:ICE20 to light. -->
        <UI>
            <UIRef Id='WixUI_Common'/>

            <TextStyle Id='WixUI_Font_Normal' FaceName='Tahoma' Size='8'/>
            <TextStyle Id='WixUI_Font_Bigger' FaceName='Tahoma' Size='12'/>
            <TextStyle Id='WixUI_Font_Title' FaceName='Tahoma' Size='9' Bold='yes'/>
            <Property Id='DefaultUIFont' Value='WixUI_Font_Normal'/>

            <!-- Names the directory the path editor edits, indirectly. -->
            <Property Id='WIXUI_INSTALLDIR' Value='APPLICATIONFOLDER'/>

            <!-- Support dialogs: progress, plus browse, failure, cancel,
                 resume, and locked-file prompts. -->
            <DialogRef Id='PrepareDlg'/>
            <DialogRef Id='ProgressDlg'/>
            <DialogRef Id='BrowseDlg'/>
            <DialogRef Id='InvalidDirDlg'/>
            <DialogRef Id='CancelDlg'/>
            <DialogRef Id='DiskCostDlg'/>
            <DialogRef Id='ErrorDlg'/>
            <DialogRef Id='FatalError'/>
            <DialogRef Id='UserExit'/>
            <DialogRef Id='ResumeDlg'/>
            <DialogRef Id='FilesInUse'/>
            <DialogRef Id='MsiRMFilesInUse'/>

            <Dialog Id='LeafInstallDirDlg' Width='370' Height='270' Title='!(loc.InstallDirDlg_Title)'>
                <Control Id='Title' Type='Text' X='15' Y='6' Width='200' Height='15'
                         NoPrefix='yes' Text='!(loc.InstallDirDlgTitle)'/>
                <Control Id='Description' Type='Text' X='25' Y='23' Width='280' Height='15'
                         NoPrefix='yes' Text='Choose where to install [ProductName].'/>
                <Control Id='BannerLine' Type='Line' X='0' Y='44' Width='370' Height='0'/>

                <Control Id='FolderLabel' Type='Text' X='20' Y='60' Width='290' Height='30'
                         NoPrefix='yes' Text='!(loc.InstallDirDlgFolderLabel)'/>
                <Control Id='Folder' Type='PathEdit' X='20' Y='100' Width='320' Height='18'
                         Property='WIXUI_INSTALLDIR' Indirect='yes'/>
                <Control Id='ChangeFolder' Type='PushButton' X='20' Y='120' Width='56' Height='17'
                         Text='!(loc.InstallDirDlgChange)'/>

                <Control Id='BottomLine' Type='Line' X='0' Y='234' Width='370' Height='0'/>
                <!-- No elevation shield: a per-user install raises no UAC prompt. -->
                <Control Id='Install' Type='PushButton'
                         X='212' Y='243' Width='80' Height='17' Default='yes'
                         Text='!(loc.VerifyReadyDlgInstall)'/>
                <Control Id='Cancel' Type='PushButton' X='304' Y='243' Width='56' Height='17'
                         Cancel='yes' Text='!(loc.WixUICancel)'>
                    <Publish Event='SpawnDialog' Value='CancelDlg'>1</Publish>
                </Control>
            </Dialog>

            <!-- Change... opens the browse dialog on the current path. -->
            <Publish Dialog='LeafInstallDirDlg' Control='ChangeFolder'
                     Property='_BrowseProperty' Value='[WIXUI_INSTALLDIR]' Order='1'>1</Publish>
            <Publish Dialog='LeafInstallDirDlg' Control='ChangeFolder'
                     Event='SpawnDialog' Value='BrowseDlg' Order='2'>1</Publish>

            <!-- Install: set the path, validate, then run unless it is bad. -->
            <Publish Dialog='LeafInstallDirDlg' Control='Install'
                     Event='SetTargetPath' Value='[WIXUI_INSTALLDIR]' Order='1'>1</Publish>
            <Publish Dialog='LeafInstallDirDlg' Control='Install'
                     Event='DoAction' Value='WixUIValidatePath' Order='2'>NOT WIXUI_DONTVALIDATEPATH</Publish>
            <Publish Dialog='LeafInstallDirDlg' Control='Install'
                     Event='SpawnDialog' Value='InvalidDirDlg' Order='3'><![CDATA[NOT WIXUI_DONTVALIDATEPATH AND WIXUI_INSTALLDIR_VALID<>"1"]]></Publish>
            <Publish Dialog='LeafInstallDirDlg' Control='Install'
                     Event='EndDialog' Value='Return' Order='4'>WIXUI_DONTVALIDATEPATH OR WIXUI_INSTALLDIR_VALID="1"</Publish>

            <!-- Stock browse-dialog path validation. -->
            <Publish Dialog='BrowseDlg' Control='OK'
                     Event='DoAction' Value='WixUIValidatePath' Order='3'>1</Publish>
            <Publish Dialog='BrowseDlg' Control='OK'
                     Event='SpawnDialog' Value='InvalidDirDlg' Order='4'><![CDATA[NOT WIXUI_DONTVALIDATEPATH AND WIXUI_INSTALLDIR_VALID<>"1"]]></Publish>

            <!-- Only fresh installs get a screen; uninstall and repair are silent. -->
            <InstallUISequence>
                <Show Dialog='LeafInstallDirDlg' Before='ProgressDlg'>NOT Installed</Show>
            </InstallUISequence>
        </UI>

        <!-- No maintenance UI, so hide the Modify button in Installed Apps. -->
        <Property Id='ARPNOMODIFY' Value='1'/>
    </Product>
</Wix>
